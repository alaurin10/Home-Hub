# Grafana datasource provisioning (example).
# Copy to the Grafana add-on's provisioning dir. Use a READ-ONLY Influx token,
# supplied via env (do NOT commit the token). See docs/00-architecture.md §8.
apiVersion: 1
datasources:
  - name: InfluxDB
    type: influxdb
    access: proxy
    # InfluxDB2 is a third-party app (Dattel/homeassistant-influxdb2) from a
    # different repo than Grafana's — its hash-prefixed hostname will differ.
    # Read the real value + port off its Info tab (docs/02 §E6); don't guess.
    url: http://CHANGE_ME_influxdb2_hostname:8086
    isDefault: true
    jsonData:
      version: Flux
      organization: home
      defaultBucket: home_assistant
    secureJsonData:
      # The Grafana add-on's env_vars option only passes through GF_-prefixed
      # names into the container (grafana/README.md) — name it GF_* even
      # though it isn't a real Grafana server setting, or it won't be set.
      token: ${GF_INFLUX_READ_TOKEN}

# Template for Home Assistant secrets.
# Copy to secrets.yaml (gitignored) and fill in real values:
#   cp secrets.yaml.example secrets.yaml
# CI copies this example to secrets.yaml to validate config without real creds.

# --- Recorder (MariaDB add-on) ---
recorder_db_url: "mysql://homeassistant:CHANGE_ME@core-mariadb/homeassistant?charset=utf8mb4"

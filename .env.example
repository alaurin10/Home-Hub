# Tooling / deploy-runner environment (NOT used by Home Assistant itself).
# Copy to .env (gitignored). Used by scripts/ and the Phase 8 deploy pipeline.
# In CI/CD these live as GitHub Actions secrets + on the self-hosted runner.

# Home Assistant API (for config reloads from the deploy runner)
HA_BASE_URL=https://homeassistant.local:8123
HA_TOKEN=CHANGE_ME_long_lived_access_token

# ESPHome OTA
ESPHOME_OTA_PASSWORD=CHANGE_ME_ota

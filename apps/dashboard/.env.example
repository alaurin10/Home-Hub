# Copy to .env (gitignored). With HA_TOKEN unset the app runs in demo mode.
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=CHANGE_ME_long_lived_access_token
# DEMO_MODE=1        # force the simulator even with a token set
# SIM_SEED=42        # demo-mode world seed
# SIM_FAULT=bedroom  # demo-mode: stage a stale node
TZ=America/Los_Angeles

# Template for ESPHome secrets (ESPHome keeps its own secrets file).
# Copy to esphome/secrets.yaml (gitignored):
#   cp esphome/secrets.yaml.example esphome/secrets.yaml
# CI copies this example so `esphome config` can validate.

wifi_ssid: "MY_IOT_SSID"
wifi_password: "CHANGE_ME"
ap_password: "CHANGE_ME_fallback"

# Native-API encryption key. The dummy below is a valid 32-byte base64 key
# (all zeros) so CI passes. Generate a REAL one per fleet:
#   esphome generate-key      (or use the ESPHome dashboard)
api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

ota_password: "CHANGE_ME_ota"
